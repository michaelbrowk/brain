[Unit]
Description=Brain Mail isolated MIME parser for one message
After=brain-mail-mime.socket

[Service]
Type=exec
User=brain-mail-mime
Group=brain-mail-mime
SupplementaryGroups=brain-mail-runtime
WorkingDirectory=/run/brain-mail-runtime/current
Environment=NODE_ENV=production
ExecStart=/opt/brain/runtime/current/bin/node --max-old-space-size=128 --disable-warning=ExperimentalWarning /run/brain-mail-runtime/current/service/mime-parser-worker.js
StandardInput=socket
StandardOutput=journal
StandardError=journal
RuntimeMaxSec=16
TimeoutStopSec=2
KillMode=mixed
UMask=0077

MemoryHigh=128M
MemoryMax=192M
CPUQuota=20%
TasksMax=8
LimitNOFILE=64
LimitCORE=0

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=true
InaccessiblePaths=/etc/brain /var/lib/brain-mail /opt/brain/notes
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=false
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
SocketBindDeny=any
RemoveIPC=true
SystemCallArchitectures=native
