[Unit]
Description=Verify and back up Brain notes
After=network-online.target brain.service
Wants=network-online.target
OnFailure=brain-alert@%n.service

[Service]
Type=oneshot
User=brain
Group=brain
Environment=NOTES_ROOT=/opt/brain/notes
Environment=BRAIN_BACKUP_ROOT=/opt/brain/backups
Environment=BRAIN_NODE_RUNTIME=/opt/brain/runtime/current/bin/node
EnvironmentFile=-/etc/brain/backup.env
Environment="GIT_SSH_COMMAND=/usr/bin/ssh -i /etc/brain/notes-deploy-key -o BatchMode=yes -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile=/etc/brain/known_hosts -o ConnectTimeout=15 -o ConnectionAttempts=2 -o ServerAliveInterval=15 -o ServerAliveCountMax=3"
ExecStart=/opt/brain/bin/backup-notes.sh
TimeoutStartSec=15min
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/opt/brain/notes /opt/brain/backups
