{
  "name": "brain",
  "version": "0.9.5",
  "description": "Self-hosted notes and mail on a folder of Markdown files.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michaelbrowk/brain.git"
  },
  "packageManager": "pnpm@11.0.4",
  "engines": {
    "node": "22.x",
    "pnpm": "11.x"
  },
  "scripts": {
    "prepare": "node scripts/install-hooks.mjs",
    "dev": "next dev",
    "deploy": "bash scripts/deploy-release.sh",
    "release": "node scripts/release.mjs",
    "export:public": "node scripts/export-public.mjs",
    "verify:public": "bash scripts/verify-public-export.sh",
    "prebuild": "node scripts/clean-standalone.mjs",
    "build": "next build",
    "postbuild": "pnpm build:mail-service",
    "build:mail-service": "node scripts/build-mail-service.mjs",
    "start": "next start",
    "lint": "eslint",
    "lint:base": "eslint",
    "test": "vitest run",
    "data-versions:capture": "vitest run test/data-versions.capture.test.ts",
    "test:deploy-ops": "python3 -m unittest discover -s ops -p '*_test.py'",
    "test:e2e": "playwright test",
    "test:e2e:release": "playwright test --grep @release",
    "test:e2e:full": "playwright test",
    "ci:local": "pnpm check && pnpm build && pnpm smoke:standalone && pnpm smoke:mail-service && pnpm test:e2e:full",
    "check:mail-egress": "pnpm --dir workers/mail-egress check",
    "probe:mail-egress": "BRAIN_MAIL_EGRESS_REQUIRE_LIVE=1 vitest run scripts/mail-egress-live.test.ts",
    "smoke:standalone": "node scripts/smoke-standalone.mjs",
    "smoke:mail-service": "node scripts/smoke-mail-service.mjs",
    "smoke:compose": "node scripts/smoke-compose.mjs",
    "verify:ops": "bash scripts/verify-ops.sh",
    "typecheck": "tsc --noEmit",
    "roundtrips": "node scripts/run-roundtrips.mjs",
    "check": "node scripts/check-forbidden-paths.mjs && node scripts/check-env-docs.mjs && pnpm lint:base && tsc --noEmit && vitest run --maxWorkers=2 && python3 -m unittest discover -s ops -p '*_test.py' && node scripts/run-roundtrips.mjs && pnpm check:mail-egress"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@milkdown/crepe": "^7.21.2",
    "@milkdown/kit": "^7.21.2",
    "@milkdown/react": "^7.21.2",
    "@radix-ui/react-alert-dialog": "^1.1.18",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.18",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-popover": "^1.1.18",
    "@zone-eu/mailsplit": "5.4.14",
    "bcryptjs": "^3.0.3",
    "cmdk": "^1.1.1",
    "fractional-indexing": "^4.0.0",
    "framer-motion": "^12.42.2",
    "gray-matter": "^4.0.3",
    "htmlparser2": "10.1.0",
    "imapflow": "1.4.7",
    "isomorphic-dompurify": "^3.22.0",
    "jose": "^6.2.3",
    "mailparser": "3.9.14",
    "marked": "^18.0.5",
    "mcp-handler": "^1.1.0",
    "mdast-util-directive": "^3.1.0",
    "mdast-util-from-markdown": "^2.0.3",
    "micromark-extension-directive": "^4.0.0",
    "nanoid": "^5.1.16",
    "next": "16.2.11",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remark-directive": "^4.0.0",
    "unicode-emoji-json": "^0.9.0",
    "ws": "8.21.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@iconify-json/solar": "^1.2.5",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "8.18.1",
    "esbuild": "0.28.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "jsdom": "^30.0.1",
    "playwright": "^1.61.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
