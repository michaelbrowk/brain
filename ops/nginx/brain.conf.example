# Reference nginx vhost for Brain. Copy to /etc/nginx/sites-available/brain,
# replace brain.example.com and the certificate paths, create the edge-secret
# include from its .example file, then: nginx -t && systemctl reload nginx.
# Brain itself listens on loopback only (HOSTNAME=127.0.0.1 PORT=3020).
#
# This file assumes nothing sits in front of nginx. If something does — see
# the real-ip block below — that is the one part you have to configure before
# the rate limits and the client addresses mean anything.

server_tokens off;

map $http_upgrade $brain_connection_upgrade {
    default upgrade;
    ""      close;
}

# --- Optional: keep an app-frame token out of the access log ------------------
#
# An app frame carries its bearer in the path
# (/api/app/<id>/t/<token>/index.html), because a sandboxed frame's relative
# requests carry no cookie and no query of their own. So the request line holds
# the token and the access log keeps it for as long as the log is kept. The token
# is short-lived and the log is the owner's, but a log is a log: uncomment these
# two, add `access_log /var/log/nginx/brain.access.log brain_scrubbed;` to the
# HTTPS server below, and that path segment is written as [redacted] instead.
#
# The pattern is anchored to the one route that carries a token in its path
# rather than looking for /t/ anywhere: a match on any path with /t/ in it is a
# match on paths this rule has no business rewriting, and an unanchored .*/t/ is
# greedy besides — it keeps the LAST /t/, so a token followed by its own /t/
# segment survived into the log.
#
# map $request_uri $brain_scrubbed_uri {
#     default "$request_uri";
#     "~^(?<brain_app_frame>/api/app/[^/]+/t/)[^/]+(?<brain_frame_path>(/.*)?)$" "$brain_app_frame[redacted]$brain_frame_path";
# }
# log_format brain_scrubbed '$remote_addr - $remote_user [$time_local] '
#                           '"$request_method $brain_scrubbed_uri $server_protocol" '
#                           '$status $body_bytes_sent "$http_referer" "$http_user_agent"';
#
# -----------------------------------------------------------------------------

# --- Optional: a proxy in front of nginx -------------------------------------
#
# Everything here is OFF by default, because a rule that rewrites the client
# address is a hole when the proxy it names is not actually there.
#
# Why it matters: the OAuth limit below keys on $binary_remote_addr, and the
# app is handed $remote_addr as X-Brain-Rate-Source. Direct on the internet,
# that address is the visitor's and nothing here is needed. Behind any proxy
# with none of this configured, it is the proxy's, so every visitor on earth
# shares one rate bucket. Never set real_ip_header without the matching
# set_real_ip_from ranges: that is what stops a client forging its own address.
#
# Behind Cloudflare — refresh the ranges from https://www.cloudflare.com/ips/
# into the include (docs/mcp-oauth.md), then uncomment all three:
#
# include /etc/nginx/brain-cloudflare-ips.conf;
# real_ip_header CF-Connecting-IP;
# real_ip_recursive on;
#
# Behind your own load balancer or reverse proxy — name its address instead
# and read the standard header:
#
# set_real_ip_from 10.0.0.0/8;
# real_ip_header X-Forwarded-For;
# real_ip_recursive on;
#
# -----------------------------------------------------------------------------

# Outer per-source limit on the public OAuth routes.
limit_req_zone $binary_remote_addr zone=brain_oauth:10m rate=10r/m;

# The owner's login. Brain caps password comparisons before bcrypt, and with no
# trusted client address that cap is one bucket for the whole internet — which is
# why a stranger's flood used to lock the owner out.
#
# What this zone does is cap ONE source at ten a minute, with five in hand for a
# typo. It does not keep a flood away from the app's shared bucket: that bucket
# admits twenty comparisons a minute, so two sources at this rate can hold it
# open, and a botnet is not short of sources. The shared bucket is the last line
# and is meant to be reachable; what keeps the owner out of it is the device
# cookie, which gives a browser that has logged in here a budget of its own and
# falls through to the shared one rather than depending on it.
limit_req_zone $binary_remote_addr zone=brain_login:10m rate=10r/m;

# MCP answers an unauthenticated call with a cheap 401, and a stranger can ask
# for as many as they like. Ten a second is far above what a real assistant
# session asks for and far below what a flood wants.
limit_req_zone $binary_remote_addr zone=brain_mcp:10m rate=600r/m;

upstream brain_app {
    server 127.0.0.1:3020;
    keepalive 16;
}

# Plain HTTP exists only to send the browser to HTTPS. Certbot's nginx plugin
# adds its own ACME exception here; a webroot renewal wants the commented line.
server {
    listen 80;
    listen [::]:80;
    server_name brain.example.com;

    # location ^~ /.well-known/acme-challenge/ { root /var/www/certbot; }

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name brain.example.com;

    ssl_certificate     /etc/letsencrypt/live/brain.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/brain.example.com/privkey.pem;

    # TLS 1.2 is the floor. The cipher list is the Mozilla intermediate set
    # without its DHE entries, which need an ssl_dhparam file this example
    # does not ship. TLS 1.3 picks its own suites and ignores ssl_ciphers.
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_session_cache shared:BrainTLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # The app sends this header too. nginx owns it here so it also rides the
    # answers the app never sees — 413, 502, and the redirect above. Drop
    # includeSubDomains if Brain sits on an apex you share with other hosts:
    # it commits every subdomain to HTTPS for the whole max-age.
    proxy_hide_header Strict-Transport-Security;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Sets $brain_edge_secret; root-readable, never in Cloudflare or Git.
    include /etc/nginx/brain-edge-secret.conf;

    # The largest body the app itself accepts: a 100 MiB portable archive at
    # POST /api/portable/import, above the 25 MiB attachment at POST /api/upload.
    # An 8m cap here answered both with a 413 that never reached the app, so the
    # limit the reader could see in the UI and the limit the edge enforced
    # disagreed. nginx buffers a body this size to disk — keep the temp path on
    # a filesystem with room for it. Lower this only together with the app's own
    # limits. The Notion binary route sets its own smaller cap below.
    client_max_body_size 101m;

    location / {
        proxy_pass http://brain_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $brain_connection_upgrade;
        proxy_set_header X-Brain-Edge-Secret "";
        proxy_set_header X-Brain-Rate-Source "";
        proxy_read_timeout 60s;
    }

    # Brain uses no next/image: every image ships as-is, never through the
    # optimizer route. The block stays as defence in depth if that changes.
    location ^~ /_next/image {
        return 404;
    }

    # Server-sent events: unbuffered, long-lived.
    location = /api/events {
        proxy_pass http://brain_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Connection "";
        proxy_set_header X-Brain-Edge-Secret "";
        proxy_set_header X-Brain-Rate-Source "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }

    # Notion binary upload: up to 25 MiB streamed through unbuffered (docs/operations.md).
    location = /api/mcp/notion-upload {
        proxy_pass http://brain_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Connection "";
        proxy_set_header X-Brain-Edge-Secret "";
        proxy_set_header X-Brain-Rate-Source "";
        client_max_body_size 26m;
        proxy_request_buffering off;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    # The owner's login: per-source limit, and both trusted headers blanked the
    # way `location /` blanks them. An exact location replaces that block
    # wholesale, so every header it needs is repeated here — the same set as
    # `location /` except for the two an upgrade needs: neither this route nor
    # /api/mcp is ever a websocket, so Connection is cleared and Upgrade is not
    # passed at all.
    location = /api/auth {
        limit_req zone=brain_login burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://brain_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Connection "";
        proxy_set_header X-Brain-Edge-Secret "";
        proxy_set_header X-Brain-Rate-Source "";
        proxy_read_timeout 60s;
    }

    # The password gate on a shared link: the same per-source bucket as the
    # login. The app counts five comparisons a minute per page for every
    # anonymous reader together, so one flooding address must not be able to
    # spend them all; many addresses still can, and docs/operations.md says so.
    location = /api/share-auth {
        limit_req zone=brain_login burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://brain_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Connection "";
        proxy_set_header X-Brain-Edge-Secret "";
        proxy_set_header X-Brain-Rate-Source "";
        proxy_read_timeout 60s;
    }

    # The MCP endpoint an assistant talks to. The larger burst is one session's
    # opening flurry of tool calls.
    location = /api/mcp {
        limit_req zone=brain_mcp burst=20 nodelay;
        limit_req_status 429;
        proxy_pass http://brain_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Connection "";
        proxy_set_header X-Brain-Edge-Secret "";
        proxy_set_header X-Brain-Rate-Source "";
        proxy_read_timeout 60s;
    }

    # Public OAuth routes: overwrite both trusted headers, outer source limit.
    # `limit_req_status` on every one of them: nginx's own answer to a limited
    # request is 503, which a client reads as an outage rather than a limit.
    location = /oauth/register {
        limit_req zone=brain_oauth burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://brain_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Connection "";
        proxy_set_header X-Brain-Edge-Secret $brain_edge_secret;
        proxy_set_header X-Brain-Rate-Source $remote_addr;
    }

    location = /oauth/token {
        limit_req zone=brain_oauth burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://brain_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Connection "";
        proxy_set_header X-Brain-Edge-Secret $brain_edge_secret;
        proxy_set_header X-Brain-Rate-Source $remote_addr;
    }

    location = /oauth/revoke {
        limit_req zone=brain_oauth burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://brain_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Connection "";
        proxy_set_header X-Brain-Edge-Secret $brain_edge_secret;
        proxy_set_header X-Brain-Rate-Source $remote_addr;
    }
}
