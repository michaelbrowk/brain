# Brain — copy this and fill it in. `.env.local` for `pnpm dev`, `.env` for
# the Docker Compose install in README.md. Never commit real values.
#
# Only the first block is required. After it come the optional features and
# paths a self-hoster may set, then the maintainer, CI and test seams, which
# exist so `pnpm check` can prove every variable the tree reads is documented
# here. You will not set those.

# --- Quickstart: the four values the Compose install needs -----------------

# Absolute path, on the host, of the folder that holds your notes. Create it
# yourself first (`mkdir`), so it belongs to you and not to root, and write
# the whole path here. The container mounts it at /opt/brain/notes, which is
# why that path is not a value for this line.
NOTES_ROOT=/absolute/path/you/choose

# Secret used to sign cookies and derive separate OAuth signing keys (32+
# bytes; `openssl rand -hex 32` makes one).
AUTH_SECRET=

# bcrypt hash of the login password, never the plaintext. README.md's install
# section has the one-liner that generates it and escapes it for Compose.
AUTH_PASSWORD_HASH=

# Exact origin your browser will show — scheme, host, port, no path, no
# trailing slash — and it must equal the address bar exactly, or adding a
# mail account is refused. Trying Brain on this machine only: set
# http://localhost:3020 — notes, login, share links and IMAP mail accounts
# all work with it. MCP (/api/mcp and its OAuth discovery, static MCP_TOKEN
# included) and Gmail's Connect flow wait for a real https:// origin, set
# once a TLS terminator is in front. `.env.local` for `pnpm dev` wants
# http://localhost:3000, the dev server's port.
BRAIN_PUBLIC_ORIGIN=https://your-domain.example

# --- Optional: features and paths a self-hoster may set --------------------

# OpenRouter powers auto-emoji, smart-sort, inbox triage, and inline AI. Left
# empty, inline assist and smart sort stay off, auto-emoji falls back to its
# keyword list, and the rest of Brain works. Inline AI sends selected text
# (max 12,000 chars). Other features send titles/ids.
OPENROUTER_API_KEY=
# Optional model override (default: openai/gpt-4o-mini)
OPENROUTER_MODEL=

# Static bearer token for MCP clients that do not support OAuth yet, and the
# only way into MCP until BRAIN_EDGE_RATE_SECRET and the nginx in
# docs/mcp-oauth.md are in place. `openssl rand -hex 32` makes one.
MCP_TOKEN=

# nginx-authenticated edge proof for bounded public OAuth rate limits.
# Generate with: openssl rand -hex 32. nginx must overwrite both trusted headers.
BRAIN_EDGE_RATE_SECRET=

# Internal deep-readiness credential for the deploy health probe (generate
# with: openssl rand -hex 32). The systemd install and `pnpm deploy` read it.
BRAIN_READINESS_TOKEN=

# The import scripts (docs/notion-import.md) reach this instance's MCP
# endpoint with MCP_TOKEN. BRAIN_MCP_URL is the absolute HTTPS URL of that
# endpoint, and its path must be exactly /api/mcp. BRAIN_MCP_ALLOWED_ORIGIN is
# the single origin that URL is allowed to belong to, checked before the
# scripts make any request; it defaults to the production origin compiled into
# the import client, so a self-hosted instance has to set it to
# its own origin.
# BRAIN_MCP_URL=
# BRAIN_MCP_ALLOWED_ORIGIN=

# State directories. The container image and the systemd units already set
# the ones they need; override only for a layout of your own.

# Directory for OAuth state. Production defaults to this dedicated private
# directory.
# BRAIN_OAUTH_STATE_DIR=/var/lib/brain/oauth

# Directory holding the session-epoch file that "log out everywhere" bumps.
# Production defaults to /var/lib/brain/auth, development to a per-user folder
# under the system temp directory.
# BRAIN_AUTH_STATE_DIR=/var/lib/brain/auth

# Once a day Brain asks api.github.com for the latest release and shows it in
# Settings → Account. The request carries nothing about your instance beyond a
# user agent naming Brain, its version and the project URL. Set to `off` to
# never call GitHub.
# BRAIN_UPDATE_CHECK=off

# Where the update check keeps its answer (default /var/lib/brain/update in
# production, a temp folder in development).
# BRAIN_UPDATE_STATE_DIR=/var/lib/brain/update

# Cache directory for proxied sender icons. Production defaults to
# /var/lib/brain/sender-icons, development to a per-user temp folder. The
# cache is reconstructible, so deleting the whole directory is safe.
# BRAIN_SENDER_ICON_DIR=/var/lib/brain/sender-icons

# Unix socket the web process uses to reach the mail service.
# BRAIN_MAIL_SOCKET_PATH=/run/brain-mail/brain-mail.sock

# Root the backup status reader looks in for attempt, success, and verified
# archive records.
# BRAIN_BACKUP_ROOT=/opt/brain/backups

# systemd install only (docs/operations.md, docs/deploy-puller.md): backups,
# failure alerts and the deploy puller. The Compose install has none of these.

# Backups (ops/backup-notes.sh, ops/verify-notes-backup.py). Heartbeat URL:
# the backup GETs it after a successful run and POSTs the status to <url>/fail
# when a run fails. Empty disables both calls.
# BRAIN_BACKUP_HEALTHCHECK_URL=

# Node binary the backup shells out to for fsync and JSON writes.
# BRAIN_NODE_RUNTIME=/opt/brain/runtime/current/bin/node

# Archive verifier the backup runs before publishing. Defaults to
# verify-notes-backup.py sitting next to the backup script.
# BRAIN_BACKUP_VERIFIER=

# Failure alerts (ops/brain-alert.sh). Normally live in /etc/brain/alert.env,
# not here. With either one missing the alert logs to the journal and exits 0,
# so it can never keep a unit failing.

# Telegram bot token used to post unit-failure notices.
# BRAIN_ALERT_TELEGRAM_TOKEN=

# Telegram chat the notices go to.
# BRAIN_ALERT_TELEGRAM_CHAT_ID=

# Deployment (ops/deploy-puller.sh, scripts/deploy-release.sh). Root of the
# deploy layout — releases, current, runtime. Must be a safe absolute path;
# the puller refuses anything else.
# BRAIN_DEPLOY_BASE=/opt/brain

# Directory holding the puller's helper scripts.
# BRAIN_DEPLOY_BIN=/opt/brain/bin

# Env file the puller reads its download credentials from.
# BRAIN_DEPLOY_ENV_FILE=/etc/brain/deployer.env

# Unprivileged user and group the puller drops to for the download step.
# BRAIN_DEPLOY_FETCH_USER=brain-deploy
# BRAIN_DEPLOY_FETCH_GROUP=brain-deploy

# ssh target scripts/deploy-release.sh connects to. Required — there is no
# default, and the script stops before it does anything when this is unset.
# BRAIN_DEPLOY_HOST=

# --- Maintainer, CI and test seams: you will not set these -----------------
# Set by CI, the smokes and the repository's own scripts. Never set them by
# hand, and never on a production host.

# Extra notes folder that scripts/verify-serialize-idempotent.mjs sweeps on top
# of its built-in fixtures. Point it at a copy of real notes (folders with
# index.md) to check production content too. Not read by the app.
# NOTES_DIR=

# Absolute path to a directory of local dev fixtures. The Liquid Glass dev
# stand (/dev/glass) reads <dir>/glass-fixtures.json for the page tree it
# draws, so a maintainer can stand it up against a tree of their own. Unset,
# missing or unparseable, the stand falls back to the sample tree in
# app/dev/glass/sample-fixtures.ts — which is what CI gets.
# BRAIN_PRIVATE_DIR=

# Path, relative to the repository root, of the word list the pre-push hook
# scans the outgoing range against. Default ../brain-word-list.txt. No list, no
# opinion — the hook exits 0, which is the ordinary case for a checkout that
# has none.
# BRAIN_WORD_LIST=

# Build and smoke seams.

# 40-character commit stamped into /api/health and into the mail service build
# identity. The mail build falls back to GITHUB_SHA, /api/health to "unknown".
# BRAIN_BUILD_SHA=

# Matching ISO-8601 UTC build timestamp (2026-08-31T12:00:00Z).
# BRAIN_BUILD_TIME=

# Port scripts/e2e-dev.mjs serves the e2e build on. Default 3021. The shot
# scripts that drive it carry their own defaults.
# BRAIN_E2E_PORT=

# Build directory next.config.ts hands Next as distDir. Unset, Next uses .next.
# The screenshot and e2e capture runs each name their own (.next-nest,
# .next/e2egm, …) so one capture never overwrites another's build, and the
# lint, vitest and git ignore rules already treat every .next-* tree as build
# output.
# BRAIN_DIST_DIR=

# Host port the docker compose smoke publishes. Default 3023.
# BRAIN_SMOKE_PORT=

# Image reference the compose smoke boots. Required, no default.
# BRAIN_SMOKE_IMAGE=

# 40-character commit the compose smoke requires both /api/health and the mail
# service to report. Required, no default.
# BRAIN_SMOKE_COMMIT=

# bcrypt hash the compose smoke hands the container as AUTH_PASSWORD_HASH.
# scripts/smoke-compose.mjs generates one; the compose file refuses to start
# without it.
# BRAIN_SMOKE_PASSWORD_HASH=

# Port the standalone smoke serves on. Default 3022, must be unprivileged.
# BRAIN_STANDALONE_SMOKE_PORT=

# IPC token that pauses standalone startup after Next installs its signal
# handlers, so the shutdown smoke can test that window. Production has neither
# the token nor an IPC channel.
# BRAIN_STANDALONE_STARTUP_BARRIER_TOKEN=

# Mail smoke seams.

# Module path of the built IMAP adapter that scripts/smoke-mail-imap-adapter.mjs
# loads.
# BRAIN_MAIL_ADAPTER_PATH=

# Port of the fake IMAP server that same smoke verifies credentials against.
# BRAIN_MAIL_FAKE_IMAP_PORT=

# /tmp socket path the MIME parser worker listens on. Refused unless NODE_ENV
# is test and the path starts with /tmp/.
# BRAIN_MAIL_MIME_TEST_SOCKET=

# Backup test seams (ops/backup-notes.sh, ops/verify-notes-backup.py). Never
# set these on a real backup host.

# Set to 1 to unlock the seams below. Without it the backup refuses a fault
# injection and the verifier refuses a limit override.
# BRAIN_BACKUP_TEST_MODE=

# JSON object shrinking the verifier's resource limits so a smoke can reach
# them. Requires test mode.
# BRAIN_BACKUP_TEST_LIMITS_JSON=

# Boundary name at which the backup injects a failure. Requires test mode.
# BRAIN_BACKUP_TEST_FAULT=

# File the backup writes its pid into and then blocks on, when the injected
# fault is attempt-write-wait, so a smoke can kill it mid-write.
# BRAIN_BACKUP_TEST_SIGNAL_READY_FILE=

# Read by the stub git the backup smoke puts on PATH: the real git it execs,
# and a file it creates when it sees a `git archive` call.
# BRAIN_BACKUP_REAL_GIT=
# BRAIN_BACKUP_TEST_GIT_ARCHIVE_LOG=

# Mail service install and rollback seams.

# Alternate root the install and rollback scripts write under. The default is
# / — a real install. Any other value puts both scripts in sandbox mode, which
# is what enables the crash seams below.
# BRAIN_MAIL_INSTALL_ROOT=/

# Set to 1 by the installer when it drives the rollback itself, so the
# rollback records an AUTO_ROLLED_BACK marker.
# BRAIN_MAIL_ROLLBACK_AUTO=

# Crash seams, sandbox mode only. Each takes the 1-based index of the file to
# stop at, proving the install and rollback resume correctly from that point.

# Fail after installing file N.
# BRAIN_MAIL_INSTALL_TEST_FAIL_AFTER=

# SIGKILL after moving file N into place, before its marker is written.
# BRAIN_MAIL_INSTALL_TEST_KILL_AFTER_MV=

# SIGKILL after writing file N's applied marker.
# BRAIN_MAIL_INSTALL_TEST_KILL_AFTER_MARKER=

# SIGKILL after restoring file N, before its marker is written.
# BRAIN_MAIL_ROLLBACK_TEST_KILL_AFTER_RESTORE=

# SIGKILL after writing file N's restored marker.
# BRAIN_MAIL_ROLLBACK_TEST_KILL_AFTER_MARKER=
