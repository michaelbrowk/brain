[Unit]
Description=Brain Mail one-message MIME parser socket
Requires=systemd-tmpfiles-setup.service
After=systemd-tmpfiles-setup.service

[Socket]
ListenStream=/run/brain-mail-mime/brain-mail-mime.sock
Accept=yes
SocketUser=brain-mail
SocketGroup=brain-mail
SocketMode=0600
DirectoryMode=0710
# Matches concurrentMimeParsers in lib/mail/security.ts; the two move together.
Backlog=2
MaxConnections=2
RemoveOnStop=true

[Install]
WantedBy=sockets.target
